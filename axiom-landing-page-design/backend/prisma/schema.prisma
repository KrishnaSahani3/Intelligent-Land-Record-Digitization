generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model LandRecord {
  id                String   @id @default(uuid())
  ownerName         String?
  fatherHusbandName String?
  khasraGataNumber  String?
  khataNumber       String?
  village           String?
  tehsil            String?
  district          String?
  landArea          String?
  landType          String?
  mutationNumber    String?
  surveyNumber      String?
  documentNumber    String?
  registrationDate  String?
  ulpin             String?
  registrationNumber String?
  status            String   @default("Requires Review")
  ocrConfidence     Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  mutations         Mutation[]
  documents         Document[]
  conflicts         Conflict[]
}

model Complaint {
  id                String   @id @default(uuid())
  complaintId       String   @unique
  complainantName   String
  mobileNumber      String
  district          String
  tehsil            String
  village           String
  khasraGataNumber  String?
  khataNumber       String?
  disputeType       String
  description       String
  oppositePartyName String?
  status            String   @default("Submitted")
  priority          String   @default("Medium")
  assignedOfficer   String?
  evidenceUrl       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  user      String
  recordId  String?
  details   String
  oldValue  String?
  newValue  String?
  timestamp DateTime @default(now())
}

model Mutation {
  id              String     @id @default(uuid())
  landRecordId    String
  landRecord      LandRecord @relation(fields: [landRecordId], references: [id])
  previousOwner   String
  newOwner        String
  date            DateTime   @default(now())
  reason          String
  status          String     @default("Pending")
  verifiedBy      String?
}

model Document {
  id                 String     @id @default(uuid())
  landRecordId       String
  landRecord         LandRecord @relation(fields: [landRecordId], references: [id])
  type               String
  uploadDate         DateTime   @default(now())
  ocrStatus          String     @default("Pending")
  confidence         Float?
  verificationStatus String     @default("Pending")
}

model Conflict {
  id              String     @id @default(uuid())
  landRecordId    String
  landRecord      LandRecord @relation(fields: [landRecordId], references: [id])
  type            String
  severity        String     @default("MEDIUM")
  description     String
  digitalValue    String?
  uploadedValue   String?
  status          String     @default("Open")
  detectedAt      DateTime   @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  userId    String?
  createdAt DateTime @default(now())
}

model Officer {
  id        String   @id @default(uuid())
  name      String
  role      String
  district  String
  status    String   @default("Active")
  lastLogin DateTime @default(now())
}
